[
  {
    "_id": "{{@ system @}}-{{@ datatype @}}-all",
    "namespaced_identifiers": false,
    "source": {
      "dataset": "{{@ system @}}-{{@ parent @}}-collect",
      "type": "dataset"
    },
    "transform": {
      "rules": {
        "default": [
          [
            "copy",
            "*",
            "variants"
          ],
          [
            "create-child",
            [
              "apply",
              "release-variants",
              "_S.variants"
            ]
          ]
        ],
        "release-variants": [
          [
            "add",
            "$original_id",
            "_R._T._id"
          ],
          [
            "add",
            "_id",
            [
              "string",
              "_S.id"
            ]
          ],
          [
            "add",
            "variants",
            "_S."
          ],
          [
            "merge",
            "_R._T"
          ]
        ]
      },
      "type": "dtl"
    },
    "type": "pipe"
  },
  {
    "_id": "{{@ system @}}-{{@ datatype @}}-all2",
    "namespaced_identifiers": false,
    "source": {
      "dataset": "{{@ system @}}-{{@ datatype @}}-all",
      "type": "dataset"
    },
    "transform": {
      "type": "emit_children"
    },
    "type": "pipe"
  },
  {
    "_id": "{{@ system @}}-{{@ datatype @}}-collect",
    "exclude_completeness": [
      "{{@ system @}}-{{@ datatype @}}-share",
      "{{@ system @}}-{{@ parent @}}-event2"
    ],
    "namespaced_identifiers": false,
    "source": {
      "dataset": "{{@ system @}}-{{@ datatype @}}-all2",
      "type": "dataset"
    },
    "transform": [
      {
        "properties": {
          "primary_key": "id",
          "share_dataset": "{{@ system @}}-{{@ datatype @}}-share"
        },
        "template": "transform-collect-rest",
        "type": "template"
      },
      {
        "rules": {
          "default": [
            [
              "copy",
              "*"
            ],
            [
              "add",
              "site_id",
              "{{@ site_id @}}"
            ]
          ]
        },
        "type": "dtl"
      },
      {
        "rules": {
          "default": [
            [
              "copy",
              "*",
              "site_id"
            ],
            [
              "comment",
              "IS-17755"
            ],
            [
              "comment",
              "fetching tax information for {{@ parent @}} price calculation. Picking province tax first, then country tax if no province tax"
            ],
            [
              "add",
              "_tax",
              [
                "first",
                [
                  "hops",
                  {
                    "datasets": [
                      "{{@ system @}}-shop-collect sc",
                      "{{@ system @}}-country-collect cc"
                    ],
                    "return": [
                      "coalesce",
                      [
                        "combine",
                        [
                          "map",
                          "_.tax",
                          [
                            "filter",
                            [
                              "eq",
                              "sc.province_code",
                              "_.code"
                            ],
                            "cc.provinces"
                          ]
                        ],
                        "cc.tax"
                      ]
                    ],
                    "where": [
                      [
                        "eq",
                        [
                          "tuples",
                          "_S.site_id",
                          true
                        ],
                        [
                          "tuples",
                          [
                            "first",
                            [
                              "split",
                              ".myshopify.com",
                              "sc.myshopify_domain"
                            ]
                          ],
                          "sc.taxes_included"
                        ]
                      ],
                      [
                        "eq",
                        "sc.country_code",
                        "cc.code"
                      ]
                    ]
                  }
                ]
              ]
            ],
            [
              "comment",
              "IS-17755"
            ],
            [
              "comment",
              "Tax_excl = Tax_incl / (1 + Tax_rate/100)"
            ],
            [
              "if",
              [
                "is-not-empty",
                "_T._tax"
              ],
              [
                "add",
                "sesam_priceExclVAT",
                [
                  "string",
                  [
                    "divide",
                    [
                      "plus",
                      1,
                      "_T._tax"
                    ],
                    [
                      "decimal",
                      "_S.variants.price"
                    ]
                  ]
                ]
              ],
              [
                "add",
                "sesam_priceExclVAT",
                "_S.variants.price"
              ]
            ],
            [
              "add",
              "$last-modified",
              [
                "max",
                "_.",
                [
                  "list",
                  [
                    "datetime-parse",
                    "%Y-%m-%dT%H:%M:%S%z",
                    [
                      "first",
                      "_S.variants.updated_at"
                    ]
                  ],
                  "_S.$last-modified"
                ]
              ]
            ]
          ]
        },
        "type": "dtl"
      }
    ],
    "type": "pipe"
  },
  {
    "_id": "{{@ system @}}-{{@ datatype @}}-share",
    "batch_size": 1,
    "namespaced_identifiers": false,
    "sink": {
      "deletion_tracking": false,
      "set_initial_offset": "onload"
    },
    "source": {
      "dataset": "{{@ system @}}-{{@ datatype @}}-transform",
      "type": "dataset"
    },
    "transform": [
      {
        "rules": {
          "default": [
            [
              "copy",
              "*"
            ],
            [
              "add",
              "site_id",
              "{{@ site_id @}}"
            ]
          ]
        },
        "type": "dtl"
      },
      {
        "rules": {
          "create_real_based_on": [
            [
              "copy",
              "*",
              "sesam_priceExclVAT"
            ]
          ],
          "default": [
            [
              "copy",
              "*",
              [
                "list",
                "$based_on",
                "$based_on_properties",
                "variants",
                "sesam_priceExclVAT",
                "site_id"
              ]
            ],
            [
              "comment",
              "IS-17755"
            ],
            [
              "comment",
              "recreate $based_on_properties without synthetic property"
            ],
            [
              "add",
              "$based_on_properties",
              [
                "filter",
                [
                  "neq",
                  "sesam_priceExclVAT",
                  "_."
                ],
                "_S.$based_on_properties"
              ]
            ],
            [
              "comment",
              "IS-17755"
            ],
            [
              "comment",
              "recreate $based_on without synthetic property"
            ],
            [
              "add",
              "$based_on",
              [
                "apply",
                "create_real_based_on",
                "_S.$based_on"
              ]
            ],
            [
              "comment",
              "IS-17755"
            ],
            [
              "comment",
              "located tax rate if taxes in shopify are included in price"
            ],
            [
              "add",
              "_tax",
              [
                "first",
                [
                  "hops",
                  {
                    "datasets": [
                      "{{@ system @}}-shop-collect sc",
                      "{{@ system @}}-country-collect cc"
                    ],
                    "return": [
                      "coalesce",
                      [
                        "combine",
                        [
                          "map",
                          "_.tax",
                          [
                            "filter",
                            [
                              "eq",
                              "sc.province_code",
                              "_.code"
                            ],
                            "cc.provinces"
                          ]
                        ],
                        "cc.tax"
                      ]
                    ],
                    "where": [
                      [
                        "eq",
                        [
                          "tuples",
                          "_S.site_id",
                          true
                        ],
                        [
                          "tuples",
                          [
                            "first",
                            [
                              "split",
                              ".myshopify.com",
                              "sc.myshopify_domain"
                            ]
                          ],
                          "sc.taxes_included"
                        ]
                      ],
                      [
                        "eq",
                        "sc.country_code",
                        "cc.code"
                      ]
                    ]
                  }
                ]
              ]
            ],
            [
              "comment",
              "IS-17755"
            ],
            [
              "comment",
              "add price "
            ],
            [
              "add",
              "_variants",
              [
                "dict",
                "price",
                [
                  "string",
                  [
                    "round",
                    2,
                    [
                      "multiply",
                      [
                        "decimal",
                        "_S.sesam_priceExclVAT"
                      ],
                      [
                        "plus",
                        1,
                        "_T._tax"
                      ]
                    ]
                  ]
                ]
              ]
            ],
            [
              "add",
              "variants",
              [
                "list", 
                [
                  "apply",
                  "recursive-merge",
                  [
                    "dict",
                    "a",
                    "_S.variants",
                    "b",
                    "_T._variants"
                  ]
                ]
              ]
            ]
          ],
          "merge-lists": [
            [
              "add",
              "result",
              [
                "map",
                [
                  "if",
                  [
                    "and",
                    [
                      "is-dict",
                      [
                        "nth",
                        "_.key",
                        "_S.a"
                      ]
                    ],
                    [
                      "is-dict",
                      "_.value"
                    ]
                  ],
                  [
                    "apply",
                    "recursive-merge",
                    [
                      "dict",
                      "a",
                      [
                        "nth",
                        "_.key",
                        "_S.a"
                      ],
                      "b",
                      "_.value"
                    ]
                  ],
                  "_.value"
                ],
                [
                  "enumerate",
                  "_S.b"
                ]
              ]
            ]
          ],
          "recursive-merge": [
            [
              "merge",
              [
                "dict",
                [
                  "map",
                  [
                    "list",
                    "_.",
                    [
                      "if",
                      [
                        "and",
                        [
                          "is-list",
                          [
                            "path",
                            "_.",
                            "_S.a"
                          ]
                        ],
                        [
                          "is-list",
                          [
                            "path",
                            "_.",
                            "_S.b"
                          ]
                        ]
                      ],
                      [
                        "path",
                        "result",
                        [
                          "apply",
                          "merge-lists",
                          [
                            "dict",
                            "a",
                            [
                              "path",
                              "_.",
                              "_S.a"
                            ],
                            "b",
                            [
                              "path",
                              "_.",
                              "_S.b"
                            ]
                          ]
                        ]
                      ],
                      [
                        "if",
                        [
                          "and",
                          [
                            "is-dict",
                            [
                              "path",
                              "_.",
                              "_S.a"
                            ]
                          ],
                          [
                            "is-dict",
                            [
                              "path",
                              "_.",
                              "_S.b"
                            ]
                          ]
                        ],
                        [
                          "apply",
                          "recursive-merge",
                          [
                            "dict",
                            "a",
                            [
                              "path",
                              "_.",
                              "_S.a"
                            ],
                            "b",
                            [
                              "path",
                              "_.",
                              "_S.b"
                            ]
                          ]
                        ],
                        [
                          "if",
                          [
                            "has-key",
                            "_.",
                            "_S.b"
                          ],
                          [
                            "path",
                            "_.",
                            "_S.b"
                          ],
                          [
                            "path",
                            "_.",
                            "_S.a"
                          ]
                        ]
                      ]
                    ]
                  ],
                  [
                    "distinct",
                    [
                      "combine",
                      [
                        "keys",
                        "_S.a"
                      ],
                      [
                        "keys",
                        "_S.b"
                      ]
                    ]
                  ]
                ]
              ]
            ]
          ]
        },
        "type": "dtl"
      },
      {
        "properties": {
          "client_side_patching": true,
          "operation_delete": "{{@ parent @}}-delete",
          "operation_insert": "{{@ parent @}}-insert",
          "operation_lookup": "{{@ parent @}}-lookup",
          "operation_update": "{{@ parent @}}-update",
          "primary_key": "id",
          "rest_system": "{{@ system @}}",
          "rewrite_rules_lookup": {
            "replace_response_body": [
              [
                "copy",
                "*",
                "variants"
              ],
              [
                "merge",
                [
                  "dict",
                  "variants",
                  [
                    "first",
                    [
                      "map",
                      "_.",
                      [
                        "filter",
                        [
                          "eq",
                          [
                            "string",
                            "_.id"
                          ],
                          [
                            "first",
                            "_R._S.$source.$id"
                          ]
                        ],
                        "_S.variants"
                      ]
                    ]
                  ]
                ]
              ]
            ],
            "rewrite_lookup": [
              [
                "copy",
                "*",
                "response_body"
              ],
              [
                "add",
                "$original_response_body",
                "_S.response_body"
              ],
              [
                "add",
                "response_body",
                [
                  "apply",
                  "replace_response_body",
                  "_S.response_body"
                ]
              ]
            ]
          },
          "rewrite_rules_payload": {
            "merge_old_payload": [
              [
                "copy",
                "*",
                "variants"
              ]
            ],
            "remove_internal_props": [
              [
                "copy", 
                "*",
                [
                  "list", 
                  "_*", 
                  "$*"
                ]
              ]    
            ],
            "rewrite_insert_payload": [
              [
                "add",
                "$payload",
                [
                  "dict",
                  "{{@ parent @}}",
                  [
                    "apply", 
                    "remove_internal_props", 
                    "_S."
                  ]
                ]
              ]
            ],
            "rewrite_update_payload_after_patch": [
              [
                "merge",
                [
                  "apply",
                  "merge_old_payload",
                  "_S._payload"
                ]
              ],
              [
                "add",
                "variants",
                [
                  "map",
                  "_.",
                  [
                    "sorted",
                    [
                      "max",
                      "_.position"
                    ],
                    [
                      "combine",
                      "_S._payload.variants",
                      [
                        "filter",
                        [
                          "neq",
                          "_.id",
                          [
                            "first",
                            "_S._payload.variants.id"
                          ]
                        ],
                        "_P._S.$original_response_body.variants"
                      ]
                    ]
                  ]
                ]
              ],
              [
                "add",
                "$payload",
                [
                  "dict",
                  "{{@ parent @}}",
                  "_T."
                ]
              ]
            ]
          },
          "share_dataset": "{{@ system @}}-{{@ datatype @}}-share"
        },
        "template": "transform-share-rest",
        "type": "template"
      }
    ],
    "type": "pipe"
  }
]
