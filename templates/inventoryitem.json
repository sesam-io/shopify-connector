[
  {
    "_id": "{{@ system @}}-{{@ datatype @}}-all",
    "batch_size": 1,
    "namespaced_identifiers": false,
    "pump": {
      "run_at_startup_if_not_populated": true,
      "schedule_interval": 300
    },
    "source": {
      "dataset": "{{@ system @}}-{{@ parent @}}-collect",
      "type": "dataset"
    },
    "transform": [
      {
        "rules": {
          "default": [
            [
              "copy",
              "_id"
            ],
            [
              "filter",
              [
                "eq", 
                "_S._deleted", 
                false
              ]
            ],
            [
              "discard",
              [
                "is-not-empty",
                [
                  "first",
                  "_S.variants.inventory_item_id"
                ]
              ]
            ],
            [
              "add",
              "id",
              [
                "first",
                "_S.variants.inventory_item_id"
              ]
            ]
          ]
        },
        "type": "dtl"
      },
      {
        "operation": "{{@ datatype @}}-lookup",
        "system": "{{@ system @}}",
        "type": "rest"
      },
      {
        "rules": {
          "default": [
            [
              "merge",
              "_S.response"
            ],
            [
              "add",
              "_id",
              [
                "string",
                "_S.id"
              ]
            ]
          ]
        },
        "type": "dtl"
      }
    ],
    "type": "pipe"
  },
  {
    "_id": "{{@ system @}}-{{@ datatype @}}-share",
    "exclude_completeness": [
      "{{@ system @}}-{{@ datatype @}}-share",
      "{{@ system @}}-{{@ datatype @}}-share"
    ],
    "namespaced_identifiers": false,
    "pump": {
      "run_at_startup_if_not_populated": true
    },
    "source": {
      "dataset": "{{@ system @}}-{{@ datatype @}}-all",
      "type": "dataset"
    },
    "transform": [
      {
        "properties": {
          "operation_lookup_delete": "{{@ datatype @}}-lookup",
          "primary_key": "id",
          "rest_system": "{{@ system @}}",
          "share_dataset": "{{@ system @}}-{{@ datatype @}}-share"
        },
        "template": "transform-collect-rest",
        "type": "template"
      },
      {
        "rules": {
          "default": [
            [
              "copy",
              "*"
            ],
            [
              "add",
              "$last-modified",
              [
                "datetime-parse",
                "%Y-%m-%dT%H:%M:%S%z",
                "_S.updated_at"
              ]
            ]
          ]
        },
        "type": "dtl"
      }
    ],
    "type": "pipe"
  },
  {
    "_id": "{{@ system @}}-{{@ datatype @}}-share",
    "batch_size": 1,
    "namespaced_identifiers": false,
    "sink": {
      "deletion_tracking": false,
      "set_initial_offset": "onload"
    },
    "source": {
      "dataset": "{{@ system @}}-{{@ datatype @}}-transform",
      "type": "dataset"
    },
    "transform": {
      "transforms": [
        {
          "rules": {
            "default": [
              [
                "copy",
                "*",
                [
                  "list",
                  "_*",
                  "$*"
                ]
              ],
              [
                "add",
                "$payload",
                [
                  "dict",
                  "inventory_item",
                  "_T."
                ]
              ],
              [
                "copy",
                "*"
              ]
            ]
          },
          "type": "dtl"
        },
        {
          "properties": {
            "operation_lookup": "{{@ datatype @}}-lookup",
            "operation_update": "{{@ datatype @}}-update",
            "primary_key": "id",
            "rest_system": "{{@ system @}}",
            "rewrite_rules_lookup": {
              "rewrite_lookup": [
                [
                  "merge",
                  "_S.{{@ datatype @}}"
                ]
              ]
            },
            "share_dataset": "{{@ system @}}-{{@ datatype @}}-share"
          },
          "template": "transform-share-rest",
          "type": "template"
        }
      ],
      "type": "chained"
    },
    "type": "pipe"
  }
]
